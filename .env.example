# Local PHP development server. Uses a separate port from pokemon-emerald-ex-dex.
PORT=3002
PHP_BINARY=php

# Vite development/preview proxy target (server-side only).
DEV_API_TARGET=http://127.0.0.1:3002

# Shared database with pokemon-emerald-ex-dex. Set matching credentials when needed.
# Reserved for future endpoints; current API routes do not connect to the database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
